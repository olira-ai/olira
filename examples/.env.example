# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# API key with the scope(s) needed for the script you're running.
# Create one with: olira keys create --name "my-key" --scopes sdk:event-log api:manage-patients
OLIRA_API_KEY=olira_dev_REPLACE_ME

# Base URL for the Olira API.
# Local development:  http://localhost:8080/app-api
# Production:        https://api.prod.olira.ai  (SDK default — omit for production)
OLIRA_BASE_URL=http://localhost:8080/app-api

# Used by 06_read_patient_state.py — set to any patient ID that already has data.
PATIENT_ID=
