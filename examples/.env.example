# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# API key with the scope(s) needed for the script you're running.
# Create one with: olira keys create --name "my-key" --scopes sdk:event-log api:manage-patients
OLIRA_API_KEY=olira_dev_REPLACE_ME

# Base URL for the Olira API. Omit this — the SDK defaults to production.
# Only set if Olira has given you a custom endpoint.
# OLIRA_BASE_URL=https://app-api.prod.olira.ai/app-api

# Used by 05_read_patient_state.py and 07_patient_token.py — set to any patient ID that already has data.
PATIENT_ID=
