# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# API key with the scope(s) needed for the script you're running.
# Create one with: olira keys create --name "my-key" --scopes sdk:event-log api:manage-patients
OLIRA_API_KEY=olira_dev_REPLACE_ME

# Base URL for the Olira API. Omit this — the SDK defaults to production.
# Only set if Olira has given you a custom endpoint.
# OLIRA_BASE_URL=https://app-api.prod.olira.ai/app-api

# Used by 06_read_patient_state.py and 07_patient_token.py — set to any patient ID that already has data.
PATIENT_ID=

# Used by 08_cohort_management.py — set to a summary type slug active in your org (e.g. symptom_snapshot).
# If omitted, the template assignment steps are skipped.
OLIRA_EXAMPLE_SUMMARY_TYPE=

# Used by 12_document_resource_ingestion.ipynb — path to a real PDF/PNG/JPEG for OCR.
# If omitted, the notebook writes a tiny stub PDF (upload works; OCR may fail on the stub).
# DOCUMENT_PATH=/path/to/note.pdf
